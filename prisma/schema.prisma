generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// Quem paga a taxa da plataforma
enum FeePayer {
  BUYER
  PRODUCER
}

/// Quem faz o reembolso quando o cliente desiste
enum RefundMode {
  /// O cliente pede pelo site e o reembolso é automático (dentro do prazo)
  SELF_SERVICE
  /// O cliente fala com o estabelecimento e o produtor reembolsa pelo painel
  PRODUCER
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Plano da casa. Os limites de cada plano ficam em src/lib/plans.ts e podem ser ajustados por casa.
enum Plan {
  FREE
  PLUS
  PRO
}

/// Cadastro de produtor: só vende depois de aprovado pelo dono da plataforma
enum ProducerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum OrderStatus {
  PENDING
  PAID
  /// Reembolso em andamento no gateway (trava contra reembolso duplicado)
  REFUNDING
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

/// Como a pessoa pagou na porta (fora do site)
enum DoorPaymentMethod {
  CASH
  PIX
  CARD
  FREE
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  FREE
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model Producer {
  id           String   @id @default(cuid())
  status       ProducerStatus @default(PENDING)
  /// Nome da casa / produtora
  name         String
  /// Nome do responsável pelo contato
  contactName  String   @default("")
  city         String?
  state        String?
  instagram    String?
  venueType    String?
  eventsPerMonth String?
  message      String?
  /// Anotações internas do dono da plataforma (o produtor não vê)
  adminNotes   String   @default("")

  plan         Plan      @default(FREE)
  /// Pro completo liberado até esta data (demonstração). Depois volta para o plano acima.
  proTrialUntil DateTime?
  /// Ajustes só desta casa (vazio = padrão do plano; 0 = ilimitado)
  limitStaff      Int?
  limitPromoters  Int?
  limitListNames  Int?
  /// Taxa especial em centésimos de % (800 = 8%). Vazio = taxa padrão da plataforma.
  feeBps          Int?
  reviewedAt   DateTime?
  email        String   @unique
  passwordHash String
  document     String // CPF ou CNPJ, só dígitos
  phone        String
  /// Id do recebedor no gateway (Pagar.me) para o split
  recipientId  String?
  bankHolder   String?
  bankCode     String?
  bankBranch   String?
  bankAccount  String?
  bankAccountDigit String?
  bankAccountType  String? // checking | savings
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events      Event[]
  advertisers Advertiser[]
  uploads     Upload[]
  staff       StaffMember[]
  resetTokens PasswordResetToken[]

  @@index([status, createdAt])
}

model Event {
  id          String      @id @default(cuid())
  producerId  String
  slug        String      @unique
  title       String
  description String      @default("")
  venueName   String
  address     String
  city        String
  state       String
  startsAt    DateTime
  endsAt      DateTime?
  bannerUrl   String?
  /// Blocos de conteúdo da página (texto, imagem, galeria, atrações, vídeo, FAQ). Ver src/lib/content.ts
  content     Json        @default("[]")
  /// Cor de destaque da página do evento
  accentColor String      @default("#facc15")
  showMap     Boolean     @default(true)
  minAge      Int         @default(18)
  status      EventStatus @default(DRAFT)
  cancelledAt  DateTime?
  cancelReason String?
  feePayer    FeePayer    @default(BUYER)

  contactPhone     String?
  contactEmail     String?
  contactInstagram String?

  /// Lista de nomes (desconto pagando na porta)
  listEnabled        Boolean   @default(false)
  /// Valor para quem está na lista (pago na porta)
  listPriceCents     Int?
  /// Valor na porta para quem não está na lista (ou chegou depois do horário da lista)
  doorPriceCents     Int?
  /// O nome na lista vale até este horário
  listValidUntil     DateTime?
  /// Até quando dá para colocar nomes
  listClosesAt       DateTime?
  /// Limite de nomes por promoter (vazio = sem limite)
  listMaxPerPromoter Int?
  /// A própria pessoa pode colocar o nome pelo link público do promoter
  listPublicSignup   Boolean   @default(true)

  refundMode          RefundMode @default(PRODUCER)
  /// Reembolso permitido até X horas antes do início
  refundDeadlineHours Int        @default(48)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  producer    Producer     @relation(fields: [producerId], references: [id])
  ticketTypes TicketType[]
  coupons     Coupon[]
  orders      Order[]
  tickets     Ticket[]
  guestList   GuestListEntry[]
  doorSales   DoorSale[]

  @@index([producerId])
  @@index([status, startsAt])
}

/// Ex.: Pista, VIP, Camarote
model TicketType {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String  @default("")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@index([eventId])
}

/// Lote: preço + quantidade + janela de vendas. O primeiro lote disponível de cada tipo é o que está à venda.
model Batch {
  id           String    @id @default(cuid())
  ticketTypeId String
  name         String
  priceCents   Int
  quantity     Int
  /// Vendidos + reservados (pedidos pendentes). Atualizado atomicamente.
  sold         Int       @default(0)
  maxPerOrder  Int       @default(10)
  salesStart   DateTime?
  salesEnd     DateTime?
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)

  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  tickets    Ticket[]

  @@index([ticketTypeId])
}

/// Anunciante/promoter cadastrado pelo produtor. Cada anunciante tem cupons.
model Advertiser {
  id         String   @id @default(cuid())
  producerId String
  name       String
  email      String?
  phone      String?
  instagram  String?
  /// PERCENT: em centésimos de % (750 = 7,5%) sobre o valor dos ingressos. FIXED: centavos por ingresso.
  commissionType  DiscountType @default(PERCENT)
  commissionValue Int          @default(0)
  /// Comissão de quem entrou pela lista / indicado na porta. FIXED = centavos por pessoa que entrou.
  /// Vazio = usa a comissão padrão acima.
  listCommissionType  DiscountType?
  listCommissionValue Int?
  /// Link secreto da área do promoter (funciona como senha)
  accessToken String   @unique
  /// Código do link público onde a própria pessoa coloca o nome na lista do promoter
  publicCode  String   @unique
  active      Boolean  @default(true)
  createdAt  DateTime @default(now())

  producer  Producer         @relation(fields: [producerId], references: [id])
  coupons   Coupon[]
  orders    Order[]
  guestList GuestListEntry[]
  doorSales DoorSale[]

  @@index([producerId])
}

model Coupon {
  id           String       @id @default(cuid())
  eventId      String
  advertiserId String?
  /// Sempre em MAIÚSCULAS
  code         String
  discountType DiscountType @default(PERCENT)
  /// Percentual (0-100) ou centavos, conforme discountType
  value        Int
  maxUses      Int?
  /// Usos de pedidos pagos + pendentes. Atualizado atomicamente.
  uses         Int          @default(0)
  validUntil   DateTime?
  active       Boolean      @default(true)
  /// Se preenchido, substitui a comissão padrão do anunciante neste cupom
  commissionType  DiscountType?
  commissionValue Int?
  createdAt    DateTime     @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])
  orders     Order[]

  @@unique([eventId, code])
}

model Order {
  id             String        @id @default(cuid())
  eventId        String
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  installments   Int           @default(1)

  buyerName      String
  buyerEmail     String
  buyerDocument  String
  buyerPhone     String

  couponId       String?
  advertiserId   String?

  subtotalCents  Int
  discountCents  Int           @default(0)
  feeCents       Int
  totalCents     Int
  /// Quanto vai para o produtor no split
  producerCents  Int
  /// Quanto fica com a plataforma no split
  platformCents  Int
  /// Comissão devida ao anunciante (paga pelo produtor, fora do split)
  commissionCents Int          @default(0)

  gatewayOrderId String?       @unique
  gatewayChargeId String?
  pixQrCode      String?
  pixQrCodeUrl   String?
  /// URL de autenticação 3DS (cartão de débito)
  authUrl        String?
  failureReason  String?
  /// Último erro ao tentar reembolsar (ex.: cancelamento do evento)
  refundError    String?

  expiresAt      DateTime
  paidAt         DateTime?
  refundedAt     DateTime?
  /// BUYER (pelo site) ou PRODUCER (pelo painel)
  refundedBy     String?
  ticketsEmailedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  event      Event       @relation(fields: [eventId], references: [id])
  coupon     Coupon?     @relation(fields: [couponId], references: [id])
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])
  items      OrderItem[]
  tickets    Ticket[]

  @@index([eventId, status])
  @@index([status, expiresAt])
  @@index([advertiserId])
  @@index([buyerEmail])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  batchId        String
  quantity       Int
  unitPriceCents Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id])

  @@index([orderId])
  @@index([batchId])
}

model Ticket {
  id          String       @id @default(cuid())
  /// Código impresso no QR. Aleatório e impossível de adivinhar.
  code        String       @unique
  orderId     String
  eventId     String
  batchId     String
  holderName  String
  status      TicketStatus @default(VALID)
  checkedInAt DateTime?
  /// Quem validou a entrada (nome do membro da portaria ou do produtor)
  checkedInBy String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@index([eventId, status])
  @@index([orderId])
}

/// Guarda webhooks já processados (idempotência: o gateway pode reenviar)
model WebhookEvent {
  id          String   @id
  type        String
  receivedAt  DateTime @default(now())
}

/// Imagens enviadas pelos produtores. Servidas com cache imutável (CDN).
/// Para volume muito alto, migrar para S3/R2 (ver README).
model Upload {
  id         String   @id @default(cuid())
  producerId String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  producer Producer @relation(fields: [producerId], references: [id])

  @@index([producerId])
}

/// Equipe de portaria: só faz check-in e consulta compradores dos eventos do produtor
model StaffMember {
  id           String    @id @default(cuid())
  producerId   String
  name         String
  /// Login único (minúsculo), ex.: "folks.portaria1"
  login        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  producer Producer @relation(fields: [producerId], references: [id])

  @@index([producerId])
}

/// Dono(s) da plataforma. Criados pelo script `npm run admin:create`.
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Link de "esqueci minha senha". Guardamos só o hash do token.
model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  producerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([producerId])
}

/// Nome na lista de um evento (colocado pelo promoter, pela própria pessoa ou pelo produtor)
model GuestListEntry {
  id           String   @id @default(cuid())
  eventId      String
  /// Promoter dono do nome (vazio = lista da casa)
  advertiserId String?
  name         String
  /// Nome normalizado (sem acento, minúsculo) para busca e para evitar duplicados
  nameKey      String
  phone        String?
  /// PROMOTER | PUBLIC | PRODUCER
  source       String
  createdAt    DateTime @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])
  doorSale   DoorSale?

  @@unique([eventId, advertiserId, nameKey])
  @@index([eventId, nameKey])
  @@index([advertiserId])
}

/// Entrada registrada na portaria com pagamento fora do site (balcão): pela lista ou venda na porta
model DoorSale {
  id               String            @id @default(cuid())
  eventId          String
  /// Se veio da lista. Único: o mesmo nome não entra duas vezes.
  guestListEntryId String?           @unique
  /// Promoter que recebe a comissão (o dono do nome, ou quem a pessoa disse na porta)
  advertiserId     String?
  name             String
  amountCents      Int
  method           DoorPaymentMethod
  commissionCents  Int               @default(0)
  /// Quem registrou na portaria
  staffName        String
  createdAt        DateTime          @default(now())

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestListEntry GuestListEntry? @relation(fields: [guestListEntryId], references: [id])
  advertiser     Advertiser?     @relation(fields: [advertiserId], references: [id])

  @@index([eventId, createdAt])
  @@index([advertiserId])
}
